        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subject", "grade", "resourceType", "authorName", "summary", "fileSizeLabel", "downloadCount", "scope", "createdAt", "updatedAt"]
    },
    "ParentNotification": {
      "title": "ParentNotification",
