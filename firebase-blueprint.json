        "viewBilling": { "type": "boolean" },
        "manageBilling": { "type": "boolean" },
        "viewTeachersEval": { "type": "boolean" },
        "managePermissions": { "type": "boolean" },
        "scope": { "type": "string", "enum": ["school"] },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "role",
        "label",
        "viewOverview",
        "viewAttendance",
        "markAttendance",
        "viewGrades",
        "publishGrades",
        "deductBehavior",
        "viewResources",
        "publishResources",
        "messageStaff",
        "messageParents",
        "viewAnnouncements",
        "manageAnnouncements",
        "viewBilling",
        "manageBilling",
        "viewTeachersEval",
        "managePermissions",
        "scope",
        "updatedBy",
        "updatedAt"
      ]
    },
