    "PollVote": {
      "title": "PollVote",
      "description": "Immutable individual vote and optional feedback comment submitted once per user per poll.",
      "type": "object",
      "properties": {
        "pollId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "voterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "voterName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "voterRole": { "type": "string", "enum": ["parent", "teacher", "admin", "supervisor"] },
        "selectedOptionIndex": { "type": "number" },
        "selectedOptionLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "comment": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pollId", "voterUid", "voterName", "voterRole", "selectedOptionIndex", "selectedOptionLabel", "createdAt"]
    },
    "EmailAlertSubscription": {
      "title": "EmailAlertSubscription",
      "description": "Per-user email alert preferences and subscribed notification categories.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "role": { "type": "string", "enum": ["parent", "teacher", "admin", "supervisor"] },
        "enabled": { "type": "boolean" },
        "alertAttendance": { "type": "boolean" },
        "alertBehavior": { "type": "boolean" },
        "alertHomework": { "type": "boolean" },
        "alertGrades": { "type": "boolean" },
        "alertPayments": { "type": "boolean" },
        "alertCirculars": { "type": "boolean" },
        "gradeLabel": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "enabled", "alertAttendance", "alertBehavior", "alertHomework", "alertGrades", "alertPayments", "alertCirculars", "createdAt", "updatedAt"]
    },
    "EmailAlertLog": {
      "title": "EmailAlertLog",
      "description": "Immutable audit log of email alerts and monthly reports dispatched via Gmail API.",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "senderEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipientName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "recipientEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "category": { "type": "string", "enum": ["attendance", "behavior", "homework", "grade", "payment", "circular", "monthly_report", "custom"] },
        "subject": { "type": "string", "minLength": 2, "maxLength": 180 },
        "bodyPreview": { "type": "string", "minLength": 2, "maxLength": 500 },
        "status": { "type": "string", "enum": ["sent", "failed"] },
        "gmailMessageId": { "type": "string", "maxLength": 128 },
        "errorMessage": { "type": "string", "maxLength": 300 },
        "autoDispatchKey": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderName", "senderEmail", "recipientUid", "recipientName", "recipientEmail", "category", "subject", "bodyPreview", "status", "createdAt"]
    },
    "QrAttendanceSession": {
      "title": "QrAttendanceSession",
      "description": "Dynamic rotating QR code session per grade and date for automated daily student attendance check-in.",
      "type": "object",
      "properties": {
        "grade": { "type": "string", "minLength": 1, "maxLength": 60 },
        "section": { "type": "string", "minLength": 1, "maxLength": 20 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "token": { "type": "string", "minLength": 6, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rotationSeconds": { "type": "number" },
        "expiresAtMs": { "type": "number" },
        "isActive": { "type": "boolean" },
        "scanCount": { "type": "number" },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "scope": { "type": "string", "enum": ["school"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["grade", "section", "date", "token", "rotationSeconds", "expiresAtMs", "isActive", "scanCount", "createdByUid", "createdByName", "scope", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
