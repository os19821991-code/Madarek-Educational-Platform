{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated school portal user profile with strict role separation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin", "teacher", "supervisor", "parent"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record linked to a guardian UID for attendance, grades, and billing.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "studentCode": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grade": { "type": "string", "minLength": 1, "maxLength": 60 },
        "section": { "type": "string", "minLength": 1, "maxLength": 20 },
        "parentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "parentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "parentPhone": { "type": "string", "minLength": 6, "maxLength": 24 },
        "gpa": { "type": "number" },
        "attendanceRate": { "type": "number" },
        "behaviorScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "studentCode", "grade", "section", "parentUid", "parentName", "parentPhone", "gpa", "attendanceRate", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily automated student attendance log with parent alert status.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "grade": { "type": "string", "minLength": 1, "maxLength": 60 },
        "parentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "status": { "type": "string", "enum": ["present", "absent", "late", "excused"] },
        "checkInTime": { "type": "string", "maxLength": 20 },
        "parentNotified": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 300 },
        "qrSessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "grade", "parentUid", "date", "status", "parentNotified", "createdAt", "updatedAt"]
    },
    "GradeRecord": {
      "title": "GradeRecord",
      "description": "Academic grade evaluation per student and subject.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "grade": { "type": "string", "minLength": 1, "maxLength": 60 },
        "parentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "term": { "type": "string", "minLength": 1, "maxLength": 60 },
        "midtermScore": { "type": "number" },
        "courseworkScore": { "type": "number" },
        "finalScore": { "type": "number" },
        "totalScore": { "type": "number" },
        "teacherNote": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "grade", "parentUid", "subject", "term", "midtermScore", "courseworkScore", "finalScore", "totalScore", "createdAt", "updatedAt"]
    },
    "TeacherEvaluation": {
      "title": "TeacherEvaluation",
      "description": "Periodic activity tracking and evaluation metrics for teaching staff.",
      "type": "object",
      "properties": {
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "department": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lessonsDelivered": { "type": "number" },
        "homeworkPublished": { "type": "number" },
        "avgResponseMinutes": { "type": "number" },
        "studentMasteryPct": { "type": "number" },
        "evaluationScore": { "type": "number" },
        "periodLabel": { "type": "string", "minLength": 1, "maxLength": 60 },
        "evaluationSummary": { "type": "string", "maxLength": 400 },
        "scope": { "type": "string", "enum": ["school"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherName", "subject", "department", "lessonsDelivered", "homeworkPublished", "avgResponseMinutes", "studentMasteryPct", "evaluationScore", "periodLabel", "scope", "createdAt", "updatedAt"]
    },
    "MessageItem": {
      "title": "MessageItem",
      "description": "Direct teacher-parent communication message.",
      "type": "object",
      "properties": {
        "parentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "senderRole": { "type": "string", "enum": ["parent", "teacher", "admin"] },
        "senderName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["parentUid", "studentId", "studentName", "teacherName", "senderRole", "senderName", "body", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "School-wide circular or instant announcement.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "body": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "category": { "type": "string", "enum": ["circular", "urgent", "academic", "event"] },
        "targetAudience": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "scope": { "type": "string", "enum": ["school"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "category", "targetAudience", "authorName", "scope", "createdAt"]
    },
    "Activity": {
      "title": "Activity",
      "description": "School extracurricular activity, educational trip, or event.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "activityType": { "type": "string", "enum": ["trip", "workshop", "competition", "ceremony"] },
        "eventDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "location": { "type": "string", "minLength": 2, "maxLength": 120 },
        "capacity": { "type": "number" },
        "registeredCount": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 300 },
        "scope": { "type": "string", "enum": ["school"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "activityType", "eventDate", "location", "capacity", "registeredCount", "scope", "createdAt", "updatedAt"]
    },
    "ActivityRegistration": {
      "title": "ActivityRegistration",
      "description": "Student registration for a school activity or trip.",
      "type": "object",
      "properties": {
        "activityId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "parentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["activityId", "studentId", "studentName", "parentUid", "createdAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Electronic tuition fee invoice and payment tracking record.",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "parentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "status": { "type": "string", "enum": ["pending", "paid", "overdue"] },
        "paymentMethod": { "type": "string", "maxLength": 60 },
        "receiptRef": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoiceNumber", "studentId", "studentName", "parentUid", "title", "amount", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "HomeworkItem": {
      "title": "HomeworkItem",
      "description": "Published homework assignment with due date for students and parents.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "grade": { "type": "string", "minLength": 1, "maxLength": 60 },
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description": { "type": "string", "minLength": 2, "maxLength": 1200 },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "scope": { "type": "string", "enum": ["school"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subject", "grade", "teacherName", "description", "dueDate", "scope", "createdAt"]
    },
    "LibraryResource": {
      "title": "LibraryResource",
      "description": "Digital library e-book, study handout, or educational reference.",
